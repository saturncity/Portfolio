---
import Scaffold from "@lenzj/site/Scaffold.astro";
import { clusters, urlFor } from "@lenzj/site/sites";
---

<Scaffold key="me">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
    {Object.entries(clusters).map(([cluster, members]) => (
      <div class="border border-neutral-800/80 p-3 bg-neutral-900/30">
        <div class="text-neutral-400 font-bold mb-2">
          {cluster.toUpperCase()} CLUSTER
        </div>
        <ul class="space-y-1">
          {members.map((s) => (
            <li>
              <a href={urlFor(s.key)} class="hover:text-emerald-400">
                {s.root ? `[root] ${s.host}` : s.host}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Scaffold>
