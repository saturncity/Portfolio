---
import "@lenzj/site/global.css";
import { bySite, urlFor } from "@lenzj/site/sites";

const self = bySite["scuba"];
const home = bySite["me"];
---

<!doctype html>
<html lang="en" class="bg-neutral-950 text-neutral-100 font-mono antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{self.title} // {self.host}</title>
    <meta name="description" content={self.blurb} />
  </head>
  <body class="p-6 max-w-3xl mx-auto space-y-6">
    <header class="border border-neutral-800 p-4 bg-neutral-900/50 flex justify-between items-center text-xs">
      <div>
        <span class="text-emerald-500 font-bold">[NODE_ONLINE]</span>
        <span class="text-neutral-400 ml-2">HOST: {self.host}</span>
      </div>
      <a
        href={urlFor(home.key)}
        class="text-neutral-500 hover:text-emerald-400"
      >
        ../{home.host}
      </a>
    </header>

    <main class="border border-neutral-800 p-6 space-y-3">
      <h1 class="text-sm font-bold text-neutral-200 uppercase tracking-wider">
        // {self.title}
      </h1>
      <p class="text-xs text-neutral-400">{self.blurb}</p>
      <p class="text-xs text-neutral-600">STATUS: SCAFFOLD. No content yet.</p>
    </main>
  </body>
</html>
