{
  "name": "lenzj-portfolios",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,astro,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,astro,css,md,json}\""
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.7.0",
    "@eslint/js": "^9.39.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.0.0",
    "turbo": "^2.10.8"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.12.0"
  }
}
